rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper Functions ───────────────────────────────────

    // Check if auth is globally enabled via config collection
    // CRITICAL: This document MUST be readable even when not logged in
    // so the app can determine if auth is required
    function isAuthEnabled() {
      // Use get() without data to check if doc exists - won't throw on missing
      return get(/databases/$(database)/documents/config/auth_settings).data.authEnabled == true;
    }

    // Check if the current user is signed in
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if the current user is an admin (the system owner).
    //
    // FIXED (task 7.1): this used to read `data.role == 'admin'` — a field
    // the app stopped writing years ago. It only kept working by accident,
    // because the two oldest super_admin accounts carry a legacy `role`
    // field from that era. Newer ones do not, so whether an owner could
    // delete a record or change a setting depended on which write path
    // created their account. The field the app actually writes is
    // `systemRole`; the legacy check is kept as a fallback so the old
    // accounts do not lose access the moment this deploys.
    //
    // Every field access is guarded by `in`: reading a field a document
    // does not have is an ERROR in rules (not a false), and an error denies
    // the request — which would have locked out every account created since
    // the field was renamed.
    //
    // The two-step shape (isAdmin → isAdminDoc) keeps `let` from evaluating
    // get() before the authentication check has passed. isAdmin() itself may
    // be called from rules (like the delete lines) that an unauthenticated
    // request can reach; the inner function may only be called once
    // isAuthenticated() has short-circuited to true.
    function isAdmin() {
      return isAuthenticated() && isAdminDoc();
    }

    function isAdminDoc() {
      let d = get(/databases/$(database)/documents/user_roles/$(request.auth.uid)).data;
      return (('systemRole' in d) && d.systemRole == 'super_admin')
        || (('role' in d) && d.role == 'admin');
    }

    // ─── Leave / HR permission helpers (task 7.1) ─────────────
    //
    // WHY THESE LIVE IN RULES AND NOT ONLY IN THE APP:
    // the client-side chain (leaveWorkflow.js) decides which buttons to
    // show, but the UI is not a security boundary — anyone with the Firestore
    // API key can write a document directly. These helpers make the same
    // decisions server-side: only the owner, HR, an approver, or the system
    // owner may move a leave request or an employee record.
    //
    // Two load-bearing conventions, followed by every helper here:
    //   1. `in` guards every optional field — a missing field must mean
    //      "does not hold the role", never an error.
    //   2. The eager `let` binding lives in an inner *Doc function that is
    //      only reachable after isAuthenticated() has passed, so get() is
    //      never evaluated with a null uid.

    function isHrDept() {
      return isAuthenticated() && hrDeptDoc();
    }

    function hrDeptDoc() {
      let d = get(/databases/$(database)/documents/user_roles/$(request.auth.uid)).data;
      return ('departmentRoles' in d) && d.departmentRoles.hasAny(['hr_staff', 'hr_manager']);
    }

    function hasLeaveApprovalRole() {
      return isAuthenticated() && leaveApproverDoc();
    }

    function leaveApproverDoc() {
      let d = get(/databases/$(database)/documents/user_roles/$(request.auth.uid)).data;
      return (('actionRoles' in d) && d.actionRoles.hasAny(['leave_supervisor', 'leave_hod', 'leave_hr_head']))
        || (('approvalRoles' in d) && d.approvalRoles.hasAny(['leave_supervisor', 'leave_hod', 'leave_hr_head']));
    }

    // The person whose employee record this is. Both link fields are
    // checked because the self-service link-back on login writes
    // linkedUserUid onto a record that only has linkedUserEmail at that
    // moment — the app's own onboarding path must not be denied by its own
    // guard.
    function ownsEmployeeRecord(employeeId) {
      return isAuthenticated() && ownsEmployeeDoc(employeeId);
    }

    function ownsEmployeeDoc(employeeId) {
      let e = get(/databases/$(database)/documents/employees/$(employeeId)).data;
      return (('linkedUserUid' in e) && e.linkedUserUid == request.auth.uid)
        || (('linkedUserEmail' in e) && e.linkedUserEmail == request.auth.token.email.lower());
    }

    // Reads of PERSONAL DATA (employees, leave_requests, user_roles) require
    // a signed-in user. Factory collections stay open-read until the wider
    // hardening pass — see the note on the employees block below.
    function canReadRecord() {
      return !isAuthEnabled() || isAuthenticated();
    }

    // ─── leave_requests write guards ─────────────────────────────────────
    //
    // CREATE and UPDATE are guarded separately because they have different
    // holes. The live suite found both (24 Oct 2026):
    //
    //   - CREATE: an owner could write a document that was already
    //     status: approved, with any day count they liked — a fully-signed
    //     leave request authored by its own beneficiary. So a created request
    //     must start life PENDING, whoever creates it. The service always
    //     writes pending_<first stage>; the rule checks the prefix so HR
    //     renaming the stages does not silently lock everyone out.
    //
    //   - UPDATE: the owner could set status: approved directly on their own
    //     pending request, forging the three-signature chain. So the owner's
    //     update branch is deliberately narrow: status may move to cancelled
    //     and nothing else, and the identity, dates and day-counts must never
    //     move at all. HR, approvers and the owner bypass the narrow branch —
    //     they are the people the app already trusts to act on requests.
    //
    // `resource` does not exist during CREATE, so the two functions must
    // never be swapped or merged: ownerEditsOwnRequest reads resource.data,
    // and evaluating it in a create rule is an error — which DENIES, and
    // would have locked every employee out of submitting leave.

    function mayCreateLeaveRequestFor(employeeId) {
      return !isAuthEnabled()
        || (isAuthenticated()
            && (isAdmin()
                || isHrDept()
                || (ownsEmployeeRecord(employeeId)
                    && request.resource.data.status.matches('^pending_.*$'))));
    }

    function ownerEditsOwnRequest(employeeId) {
      return ownsEmployeeRecord(employeeId)
        && (request.resource.data.status == resource.data.status
            || request.resource.data.status == 'cancelled')
        && request.resource.data.requestedDays == resource.data.requestedDays
        && request.resource.data.employeeId == resource.data.employeeId
        && request.resource.data.leaveCommences == resource.data.leaveCommences
        && request.resource.data.leaveEnds == resource.data.leaveEnds
        && request.resource.data.entitledAtRequest == resource.data.entitledAtRequest
        && request.resource.data.outstandingAfter == resource.data.outstandingAfter;
    }

    function mayWriteLeaveRequestFor(employeeId) {
      return !isAuthEnabled()
        || (isAuthenticated()
            && (isAdmin()
                || isHrDept()
                || hasLeaveApprovalRole()
                || ownerEditsOwnRequest(employeeId)));
    }

    // Allow a normal (non-admin) signed-in user to write a record
    function canWriteRecord() {
      return !isAuthEnabled() || isAuthenticated();
    }

    // ─── config/auth_settings ───────────────────────────────
    // CRITICAL: This MUST be publicly readable so the app can check 
    // if auth is enabled BEFORE requiring login (avoids permission loops)
    match /config/auth_settings {
      allow read: if true;  // Anyone can check auth status
      allow write: if isAdmin();  // Only admins can modify
    }

    // ─── config collection (other docs) ─────────────────────
    match /config/{docId} {
      allow read: if true;  // Allow anyone to read config when authenticated
      allow write: if !isAuthEnabled() || isAdmin();
    }

    // ─── user_roles collection ─────────────────────────────
    // WHO CAN READ: any signed-in user. This used to be world-readable,
    // which put every staff member's email and roles on the open internet
    // for anyone holding the API key. The client-side role checks the old
    // comment cited all happen AFTER login, so requiring a signed-in user
    // breaks nothing.
    match /user_roles/{userId} {
      allow read: if canReadRecord();
      // WHO CAN WRITE: the system owner, or HR (hr_staff / hr_manager) —
      // but HR may never create or promote a super_admin. That escalation
      // path was open in the UI until task 1.6 closed it client-side; this
      // is the same decision enforced server-side, so the UI and the
      // database can no longer disagree about who hands out god-mode.
      allow create: if !isAuthEnabled()
        || (isAuthenticated() && (isAdmin() || (isHrDept() && request.resource.data.systemRole != 'super_admin')));
      allow update: if !isAuthEnabled()
        || (isAuthenticated() && (isAdmin() || (isHrDept() && request.resource.data.systemRole != 'super_admin')));
      allow delete: if !isAuthEnabled() || isAdmin();
    }

    // ─── employees (HR master records) ─────────────────────
    // The HR record for a person, keyed by a generated employeeId —
    // deliberately NOT the Firebase UID, so staff who never log in
    // still have a record and can still request leave.
    //
    // SECURITY (fixed, task 7.1): these records hold names, SAP numbers,
    // phone numbers, addresses and joining dates — genuine personal data.
    // They used to be readable by anyone on the internet with the API key
    // (verified live: an unauthenticated REST read returned HTTP 200). Reads
    // now require a signed-in user.
    //
    // WRITES: HR manages the roster; the system owner may too; and the
    // employee themselves may write their OWN record for one purpose — the
    // self-service link-back that pins linkedUserUid on first login
    // (AuthContext). A random qc_staff writing someone else's HR record is
    // now refused by the database, not just hidden by the UI.
    match /employees/{employeeId} {
      allow read: if canReadRecord();
      allow create: if !isAuthEnabled()
        || (isAuthenticated() && (isAdmin() || isHrDept()));
      allow update: if !isAuthEnabled()
        || (isAuthenticated() && (isAdmin() || isHrDept() || ownsEmployeeRecord(employeeId)));
      allow delete: if !isAuthEnabled() || isAdmin();
    }

    // ─── leave_requests ────────────────────────────────────────────
    // One document per leave request, mirroring the paper Leave Request Form
    // field for field.
    //
    // SECURITY (fixed, task 7.1): the KNOWN LIMITATION that used to sit here
    // — any authenticated user could updateDoc anyone's request — is closed.
    // The sequential chain in leaveWorkflow.js still decides which buttons
    // the UI shows, but the rules now enforce the same decision server-side:
    // a request may only be created or changed by its owner, HR, a leave
    // approver, or the system owner. The UI is no longer the only thing
    // standing between a staff member and the CEO's leave history.
    match /leave_requests/{requestId} {
      allow read: if canReadRecord();
      allow create: if mayCreateLeaveRequestFor(request.resource.data.employeeId);
      allow update: if mayWriteLeaveRequestFor(resource.data.employeeId);
      allow delete: if !isAuthEnabled() || isAdmin();
    }

    // ─── leave_notifications (email queue) ─────────────────────────
    // One document per (leave request, event) pair — deterministic id:
    // {requestId}_{event}. The app writes 'queued', the Worker reads via the
    // caller's own token and either skips (status: 'sent') or sends and
    // returns { ok: true, recipients: [...] }, which the app records as
    // 'sent'. Failures become 'failed' with an error string.
    //
    // READ: any authenticated user — the Worker reads with the caller's
    //       token, and the app needs to show the queue on the request card.
    // WRITE: the owner (their own requests), HR, approvers, or the system
    //        owner. The app only writes at the exact choke points (submit,
    //        sign, approve, reject, lodge, cancel, recall).
    // DELETE: system owner only — queue documents are an audit trail.
    match /leave_notifications/{notificationId} {
      allow read: if canReadRecord();
      allow create: if !isAuthEnabled()
        || (isAuthenticated()
            && (isAdmin()
                || isHrDept()
                || hasLeaveApprovalRole()
                || (ownsEmployeeRecord(get(/databases/$(database)/documents/leave_requests/$(request.resource.data.requestId)).data.employeeId)
                    && request.resource.data.status == 'queued')));
      allow update: if !isAuthEnabled()
        || (isAuthenticated()
            && (isAdmin()
                || isHrDept()
                || hasLeaveApprovalRole()
                || ownsEmployeeRecord(get(/databases/$(database)/documents/leave_requests/$(resource.data.requestId)).data.employeeId)));
      allow delete: if !isAuthEnabled() || isAdmin();
    }

    // ─── ALERTS ─────────────────────────────────────────────
    // System activity/notification feed — any authenticated user posts/reads
    match /alerts/{alertId} {
      allow read: if true;
      allow create: if canWriteRecord();
      allow update: if canWriteRecord();
      allow delete: if !isAuthEnabled() || isAdmin();
    }

    // ─── QC - Sachet (string weight) checks ──────────────────
    match /qc_string_weight_checks/{checkId} {
      allow read: if true;
      allow create: if canWriteRecord();
      allow update: if canWriteRecord();
      allow delete: if !isAuthEnabled() || isAdmin();
    }

    // ─── QC - Bag inspection checks ──────────────────────────
    match /qc_bag_inspection_checks/{checkId} {
      allow read: if true;
      allow create: if canWriteRecord();
      allow update: if canWriteRecord();
      allow delete: if !isAuthEnabled() || isAdmin();
    }

    // ─── QC - Carton inspection checks ───────────────────────
    match /qc_carton_inspection_checks/{checkId} {
      allow read: if true;
      allow create: if canWriteRecord();
      allow update: if canWriteRecord();
      allow delete: if !isAuthEnabled() || isAdmin();
    }

    // ─── QC - main tests ─────────────────────────────────────
    match /qc_tests/{testId} {
      allow read: if true;
      allow create: if canWriteRecord();
      allow update: if canWriteRecord();
      allow delete: if !isAuthEnabled() || isAdmin();
    }

    // ─── Carton (waste) records ──────────────────────────────
    match /carton_records/{cartonId} {
      allow read: if true;
      allow create: if canWriteRecord();
      allow update: if canWriteRecord();
      allow delete: if !isAuthEnabled() || isAdmin();
    }

    // ─── Laminate (waste) records ────────────────────────────
    match /laminate_records/{laminateId} {
      allow read: if true;
      allow create: if canWriteRecord();
      allow update: if canWriteRecord();
      allow delete: if !isAuthEnabled() || isAdmin();
    }

    // ─── Empty silo records ──────────────────────────────────
    match /empty_silos/{siloId} {
      allow read: if true;
      allow create: if canWriteRecord();
      allow update: if canWriteRecord();
      allow delete: if !isAuthEnabled() || isAdmin();
    }

    // ─── Pallet transfers ────────────────────────────────────
    match /pallet_transfers/{transferId} {
      allow read: if true;
      allow create: if canWriteRecord();
      allow update: if canWriteRecord();
      allow delete: if !isAuthEnabled() || isAdmin();
    }

    // ─── Stopped machines ────────────────────────────────────
    match /stopped_machines/{machineId} {
      allow read: if true;
      allow create: if canWriteRecord();
      allow update: if canWriteRecord();
      allow delete: if !isAuthEnabled() || isAdmin();
    }

    // ─── Machine issues ──────────────────────────────────────
    match /machine_issues/{issueId} {
      allow read: if true;
      allow create: if canWriteRecord();
      allow update: if canWriteRecord();
      allow delete: if !isAuthEnabled() || isAdmin();
    }

    // ─── Shift approvals ─────────────────────────────────────
    match /shift_approvals/{approvalId} {
      allow read: if true;
      allow create: if canWriteRecord();
      allow update: if canWriteRecord();
      allow delete: if !isAuthEnabled() || isAdmin();
    }

    // ─── Report configs ──────────────────────────────────────
    match /report_configs/{reportId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null;
    }

    // ─── Presence (the heartbeat) ────────────────────────────
    match /presence/{userId} {
      // Anyone logged in can see who is online
      allow read: if true;
      // A user is ONLY allowed to update their own heartbeat document!
      allow write: if !isAuthEnabled() || (isAuthenticated() && request.auth.uid == userId);
    }

    // ─── Default catch-all ─────────────────────────────────
    // When auth is DISABLED → full access
    // When auth is ENABLED  → read: authenticated, write: admin only
    match /{document=**} {
      allow read: if !isAuthEnabled() || isAuthenticated();
      allow write: if !isAuthEnabled() || isAdmin();
    }
  }
}
